# Skopiuj do `.env.local` i uzupełnij. Plik `.env.local` jest w .gitignore.

# Publiczny, absolutny URL strony. Używany przez metadataBase, sitemap i Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adres, na który trafiają zgłoszenia z formularza wyceny (tylko serwer).
LEAD_NOTIFICATION_EMAIL=

# Klucz dostawcy e-mail. Dopóki jest pusty, akcja formularza loguje zgłoszenie
# i zwraca sukces — patrz src/server/lead/lead-delivery.ts.
RESEND_API_KEY=
