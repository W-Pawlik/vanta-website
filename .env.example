# Skopiuj do `.env.local` i uzupełnij. Plik `.env.local` jest w .gitignore.

# Publiczny, absolutny URL strony. Używany przez metadataBase, canonical, hreflang,
# sitemap i Open Graph. W buildzie produkcyjnym jest WYMAGANY i musi być adresem
# `https://` — bez niego `pnpm build` przerywa pracę, bo origin jest zapiekany
# w statycznym HTML obu locale i nie da się go poprawić po deployu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adres, na który trafiają zgłoszenia z formularza wyceny (tylko serwer).
LEAD_NOTIFICATION_EMAIL=

# Klucz dostawcy e-mail. Dopóki jest pusty, akcja formularza loguje zgłoszenie
# i zwraca sukces — patrz src/server/lead/lead-delivery.ts.
RESEND_API_KEY=
